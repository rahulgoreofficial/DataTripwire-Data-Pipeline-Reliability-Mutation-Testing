# DataTripwire Environment Configuration Template
# Copy this file to .env for local adjustments.
# Note: DataTripwire requires NO external API keys or paid services. It runs 100% locally.

# Application Environment (development, testing, production)
DATATRIPWIRE_ENV=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
DATATRIPWIRE_LOG_LEVEL=INFO

# Backend API server configuration (Phase 2)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend development server configuration (Phase 3)
FRONTEND_PORT=5173
